# Sao chép thành .env rồi điền giá trị. Không commit .env.

# Bắt buộc để chạy AI thật (chế độ Phát lại không cần).
OPENAI_API_KEY=

# Cố định theo build plan; đổi MODEL_WRITER nếu muốn dùng model khác cho A3/A4.
MODEL=gpt-5.6-luna
MODEL_WRITER=gpt-5.6-luna

# openai = gọi API thật; rule = chạy hoàn toàn offline bằng bảng luật.
DECISION_ENGINE=openai

# Đặt giá trị này khi deploy công khai: cả trang sẽ hỏi mật khẩu trước khi vào.
# Để trống khi chạy local.
LUMI_APP_PASSWORD=

# --- Giọng nói ---
# Đặt off để tắt hẳn ghi âm và đọc câu trả lời. Nên tắt nếu muốn siết chi phí,
# vì mỗi lượt nói tốn thêm một lần gọi phiên âm và một lần tổng hợp giọng.
LUMI_VOICE=on

# Hai model audio. Đây là ngoại lệ có chủ đích với quy tắc một model duy nhất:
# model hội thoại không phiên âm và không đọc được. Để trống thì dùng mặc định.
# gpt-4o-transcribe cho kết quả tiếng Việt chính xác nhất trong ba model đã thử.
MODEL_STT=gpt-4o-transcribe
MODEL_TTS=gpt-4o-mini-tts

# Trần số lượt giọng nói mỗi phiên (một lượt = một lần phiên âm hoặc một lần
# đọc). Hết trần thì micro và nút Nghe biến mất, phần gõ phím vẫn nguyên.
# Đây là chặn ở tầng ứng dụng; spending limit bên OpenAI là lớp cuối.
LUMI_VOICE_MAX_ACTIONS=20

# Trần số lượt What-if có gọi D3/D5 trong mỗi phiên. Các phép thử chỉ chạy
# scoring/finance bằng code không tính vào trần và luôn dùng được.
LUMI_WHATIF_MAX_ACTIONS=8

# Tuỳ chọn: trỏ tới knowledge base ở vị trí khác.
# LUMI_KB_PATH=
